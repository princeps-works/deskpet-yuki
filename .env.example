# Desktop Pet 配置模板
# 复制为 .env 后填写。未列出的高级参数直接采用代码默认值。
# 布尔值支持 true/false、1/0、yes/no、on/off。

# -----------------------------------------------------------------------------
# LLM / 多模态模型
# -----------------------------------------------------------------------------
# OpenAI 兼容接口密钥。留空时聊天会进入离线回声模式。
N1N_API_KEY=
# OpenAI 兼容接口根地址；当前项目使用 DeepSeek 接口。
N1N_BASE_URL=https://api.deepseek.com
# 聊天、评论、联网规划和图像理解使用的模型。未单独设置 VISION_MODEL_NAME 时，
# 视觉请求也使用此模型，因此该模型必须支持图像输入。
MODEL_NAME=deepseek-v4-flash-vision-exp

# -----------------------------------------------------------------------------
# 自动评论、视觉小说扫描
# -----------------------------------------------------------------------------
# 普通自动评论的目标间隔，单位秒；实际会加入约 ±30 秒随机抖动。
# 这不是OCR采样频率。视觉小说模式下也不依靠它逐句触发评论。
SCREEN_SCAN_INTERVAL_SEC=300
# 启动时是否启用视觉小说专用处理。注意：后台自动扫描启动时仍默认为关闭，
# 需要在浮窗中手动开启；关闭自动扫描后仍可在聊天/联网中读取已有剧情缓存。
ENABLE_VISUAL_NOVEL_MODE=true
# OCR文本与最近3条有效剧情的本地语义相似度硬下限。
# 低于该值不写入缓存；设为0可关闭。过高可能误删场景切换或剧情转折。
VN_MIN_CONTEXT_SIMILARITY=0.30
# 普通模式下扫描调度器的轮询间隔，单位秒；视觉小说模式固定为1秒。
SCAN_TICK_INTERVAL_SEC=12
# 普通模式下两次扫描任务提交的最短间隔，单位秒；耗时较长时会自动放宽。
# 视觉小说模式的基础值固定为1秒，但同样受自适应负载控制。
SCAN_SUBMIT_MIN_INTERVAL_SEC=15
# 单次扫描任务超过该秒数仍未完成时重启扫描器。
SCAN_BUSY_TIMEOUT_SEC=40
# 启动时就打开「自动扫描」。默认 false：启动时自动扫描始终是关的，即使
# ENABLE_VISUAL_NOVEL_MODE=true 也不会自动打开——想让它开机就持续观察屏幕，
# 才设为 true。注意 OCR 文本与画面理解（视觉）都以自动扫描为前置条件，所以
# 默认状态下需要手动点桌宠面板上的「自动扫描：开」；手动开启视觉小说模式时
# 仍会自动带上自动扫描（退出该模式时恢复你原来的选择）。
AUTO_START_SCAN=false
# 负载自适应扫描间隔的上限（秒）。间隔本来会放宽到「OCR耗时 × 1.35」，
# 视觉小说模式下那会让扫描显得很慢，所以这里压到 2 秒。
SCAN_ADAPTIVE_MAX_INTERVAL_SEC=2.0
# 文本区读不到字时，会扫描多个候选带兜底——这一轮要跑多次 OCR（实测约 17 秒），
# 所以限流：至少间隔该秒数、且画面确实变化过，才做整窗兜底。
OCR_FALLBACK_MIN_INTERVAL_SEC=15.0

# -----------------------------------------------------------------------------
# OCR 性能
# -----------------------------------------------------------------------------
# RapidOCR/ONNX运行线程数。0表示运行库默认；线程过多会与Live2D争抢CPU。
OCR_CPU_THREADS=4
# OCR子进程最多绑定的CPU核心数。0表示不额外限制。
OCR_CPU_AFFINITY_COUNT=6
# OCR输入图像最长边；0保持原图。缩小可提速，但过小会降低小字识别率。
OCR_MAX_EDGE=960

# -----------------------------------------------------------------------------
# 多模态图像请求
# -----------------------------------------------------------------------------
# 单次视觉API请求超时，单位秒，允许范围1~30。
MM_TIMEOUT_SEC=20
# 连续失败多少次后进入多模态熔断，允许范围1~12。
MM_FAILURE_THRESHOLD=4
# 熔断后暂停视觉API请求的秒数，允许范围10~3600；OCR仍可继续工作。
MM_COOLDOWN_SEC=90
# 上传给视觉模型前的图像最长边，允许范围320~2048；越大越清晰但更慢。
MM_IMAGE_MAX_EDGE=1024
# 单次图像理解回复的最大输出token，允许范围64~1024。
MM_OUTPUT_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# VoiceVox 日语语音
# -----------------------------------------------------------------------------
# 语音提供商：当前使用voicevox。其他受支持值为edge、azure。
TTS_PROVIDER=voicevox
# Start long VOICEVOX sentences at a balanced clause boundary; false restores sentence-only synthesis.
TTS_VOICEVOX_CLAUSE_STREAMING=true
# VoiceVox发声前是否把中文回复翻译成日语。
ENABLE_VOICEVOX_JA_TRANSLATION=true
# 翻译后端：local=本地M2M100，index=免费Index API，index_local=本机Index 2B，api=主LLM，none=不翻译。
# index_local先运行 scripts/start_index_translation.ps1；端点127.0.0.1:8768，失败回退M2M100。
# Index仅翻译请求直连，3秒网络操作超时、不重试；无需API Key。修改后重启生效。
# 当前默认模型目录为 assets/models/m2m100_418M_ct2。
TTS_TRANSLATION_PROVIDER=local

# -----------------------------------------------------------------------------
# 自动评论短期记忆权重
# -----------------------------------------------------------------------------
# 自动评论周期内，屏幕摘要按时间衰减的窗口秒数。0表示按评论周期自动计算。
# 该参数不控制聊天长期记忆或视觉小说剧情缓存。
MEMORY_RECENCY_WINDOW_SEC=30
# 超出时间窗口的屏幕摘要仍保留的最低权重，范围0~1。
MEMORY_MIN_WEIGHT=0.1

# -----------------------------------------------------------------------------
# Live2D 与 Windows 资源调度
# -----------------------------------------------------------------------------
# 使用外部live2d-py渲染进程；全局Live2D总开关默认开启。
ENABLE_LIVE2D_PY=true
# 鼠标距离模型多少像素以内时激活视线跟随，范围40~2000。
LIVE2D_FOLLOW_ACTIVATE_DISTANCE_PX=150
# Windows进程优先级/CPU亲和策略重复应用的最短间隔秒数，范围0.2~20。
# 调高可减少系统调用，调低可更快响应扫描、拖拽和跟随状态变化。
RESOURCE_POLICY_REAPPLY_MIN_SEC=5.0

# -----------------------------------------------------------------------------
# 视觉小说 · 画面理解（异步视觉）
# -----------------------------------------------------------------------------
# 截图来源：window=直接读取游戏窗口自身内容（PrintWindow，不会被遮挡、不会拍到桌宠）；
# manual=使用手动框选的画面区域（「框选画面区域」按钮，配合独占全屏游戏）。
# 两种模式都可以在桌宠悬浮侧栏里直接切换。
VISION_CAPTURE_MODE=window
# window 模式下，窗口内容区内再收窄的比例（左右/上下各裁掉，0~0.45）。
VISION_WINDOW_INSET_LR=0.0
VISION_WINDOW_INSET_TB=0.0
# window 模式下向外扩张的像素，用于纳入窗口边框外的画面。
VISION_WINDOW_MARGIN_PX=0
# 绑定到指定显示器（0=不限制，跟随窗口所在屏幕）。
VISION_WINDOW_MONITOR_INDEX=0
# 画面理解的取样配额：按「张/分钟」补充。3 = 平均每 20 秒一张。
# 注意这不是硬间隔——画面出现大变化时可以立刻用掉已有配额，不用等时钟。
# 因此最值得看的 CG／片头 movie 不会被"离上一帧太近"挡掉。
VISION_SHOTS_PER_MINUTE=3
# 最多能积攒几张配额。防止长时间静止后的突然爆发式请求；取 3 表示
# 静默两分钟后最多也只是一次性用掉 3 张，之后回到 20 秒一张。
VISION_BURST_CAP=3
# 两次画面理解之间的最小间隔（秒）。令牌桶只管「总量」，管不住「多快花掉」：
# 攒了 3 张的话，片头 movie 头几秒就能全打完，后面 80 秒一张都看不了。
# 这个下限把取样铺开到整段场景。设 0 关闭。
# 实测（cap=3、3张/分、下限6秒，90秒内画面一直在变）：
#   触发时刻 = [0, 6, 12, 21, 40, 60, 80]，共 7 张，而不是前 9 秒打光 3 张。
VISION_MIN_GAP_SEC=6
# 画面变化超过该比例才值得看（0~1）。数值越小越灵敏、调用越多。
VISION_CHANGE_THRESHOLD=0.10
# 一次画面理解的描述多久内仍然算有效上下文（秒）。
# Cutscene 变化快，所以不要设太长，否则会拿过期描述去评论当前画面。
VISION_CONTEXT_TTL_SEC=30
# 兼容旧配置：已不再是"最小间隔"闸门，留空即可（设了也不影响）。
VISION_MIN_INTERVAL_SEC=0
# 可选的每小时硬顶，0 = 不限制。配额主要由 VISION_SHOTS_PER_MINUTE 控制。
VISION_BUDGET_PER_HOUR=0
# 引导视觉模型关注什么（不要让它重新抄写台词）。
VISION_FOCUS_QUERY=主角表情与情绪、立绘或服装变化、是否出现CG画面、场景地点与时间
# 锁定要截取的游戏窗口（按标题子串匹配，留空=自动挑最像游戏的窗口）。
# 自动模式会优先选「几乎铺满屏幕且标题不像浏览器/资源管理器」的窗口；
# 如果仍抓错，把游戏窗口切到前台后在侧栏点「锁定此窗口」即可。
VISION_TARGET_TITLE=
# OCR 文本区的分辨率上限。实测（2560x672 对话框裁剪、4线程）：
# 640~800 读同样 27 字只要 ~1.75s，而 1600 要 ~4.5s 且没有多认出一个字。
# 所以这里保持不大；调高只会更慢。
OCR_TEXT_MAX_EDGE=800
# 文本区变化多少才重新跑 OCR。此项已不再参与视觉小说模式的对话判断（那里改用下面
# 的墨迹比较），保留仅为兼容旧配置；视觉小说模式请调 OCR_TEXT_INK_CHANGE_THRESHOLD。
OCR_TEXT_CHANGE_THRESHOLD=0.008
# 视觉小说模式下判断「台词变了没有」的阈值，比较的是对话框裁剪图的「墨迹」分布
# （把裁剪图缩到 192x48，标记偏离中位亮度的格子，再按有墨迹的格子算差异比例）。
# 旧的灰度均值指纹在实测的 1979x369 对话框上完全看不出短句变化：
#   「嗯。」→「走吧。」只 0.0064，仅换说话人只 0.0032，都低于 0.008 ——
#   于是 OCR 被跳过，永远返回读到的第一句（表现为「只读第一句，之后不更新」）。
# 换成墨迹比较后同样的变化是 0.52~0.97，而完全相同的帧和整体明暗变化都是 0.00。
# 除非你把对话框框得特别小或特别大，否则不建议改。
OCR_TEXT_INK_CHANGE_THRESHOLD=0.12
# 自动文本区在底部要忽略掉的高度比例。游戏底部的 SAVE/LOAD/CONFIG 菜单条会被 OCR
# 读进来，和台词直接粘在一起（「……没什么变化。 SAVELOADCONFIGSKIPQ.SAVE…」），而
# 质量过滤把它判成 quality_ok，于是界面文字被当成台词写进剧情缓存。
# 在《青空下的加缪》(2560x1600) 实测：台词底部约在 91% 高度，菜单条在 93~95%，
# 95.5% 以下已是黑边，所以默认切掉底部 8%（文本区到 92% 为止）。
# 如果你的游戏把对话框放得更靠底部，把这项调小甚至设为 0。
VN_TEXT_BAND_BOTTOM_MARGIN=0.08
# 主读取完全读不到字时的重试带起点（窗口高度的比例）。App 假定对话框在下方那一段，
# 读不到就再试它上面这一条——居中文本框的游戏对话框在这里。
# 两段互不重叠（30%~58% 与 58%~92%），所以每一趟 OCR 都在读新的像素。
# 之前是四条互相重叠的带（92/76/60/44 锚点），其中一条完全落在主带内部，
# 等于花一整趟 OCR 重读同样的像素，却把真正该覆盖的中上部丢了。
VN_TEXT_BAND_MID_TOP_RATIO=0.30
# 对话框连续多久读不到字，才值得启动扫带（秒）。偶尔一次读空是正常的：换行瞬间、
# 场景切换、淡入淡出被抓到某一帧都会空一拍。之前只要一读空就立刻扫带，于是对话框
# 每次短暂消失都要付一次约 10 秒的恢复代价。现在要求连续 5 秒没有文字才扫。
OCR_FALLBACK_MIN_QUIET_SEC=5.0
# 每小时的视觉请求上限（0=不限制）。这是成本上限，宁可放宽也不要靠冷却限流。
VISION_BUDGET_PER_HOUR=60
# 打印窗口解析的候选打分（排查"抓错窗口"时设为 1）。
VISION_DEBUG_RESOLVE=0
# 文本区起点比例：0.58 表示取窗口下方 42% 作为 OCR 文本区。
VN_TEXT_REGION_RATIO=0.58
# 剧情事实总量上限。
VN_MAX_FACTS=60

# -----------------------------------------------------------------------------
# 剧情事实语义去重（阈值标定）
# -----------------------------------------------------------------------------
# 两条事实的字符 2-gram Jaccard 相似度超过该值即判定重复并合并。
DEDUP_NGRAM_MERGE=0.75
# 语义合并仍需词法证据；这是字符2-gram的最低辅助门槛。
DEDUP_NGRAM_GUARD=0.12
# 语义余弦阈值。中文短文本的余弦分布被压缩，不相关句子常达 0.6~0.8，
# 因此该值必须偏高；请结合标定文件观察实际分布后再调整。
DEDUP_SEMANTIC_MERGE=0.82
# Reuse the existing encoder to rank VN comment overlap candidates; false restores the old prompt.
ENABLE_SEMANTIC_COMMENT_CANDIDATES=true
# 记录每次去重决策（cosine / ngram / char_ratio / 判定结果）用于标定阈值。
DEDUP_CALIBRATION_ENABLED=true
DEDUP_CALIBRATION_PATH=data/dedup_calibration.jsonl

# Only VN streamed automatic comments on DeepSeek V4: false restores thinking.
VN_FAST_REASONING=true
