+_tts_lock = threading.Lock()
+_tts_jobs = {}
+_cancelled_ids = deque(maxlen=128)
+
+
+@APP.post("/cancel_tts")
+async def cancel_tts(request_id: str):
+    _cancelled_ids.append(request_id)
+    event = _tts_jobs.get(request_id)
+    if event is not None:
+        event.set()
+    return {"cancelled": True, "request_id": request_id}
